DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.php

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
	Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_authz_core.c>
	<FilesMatch "\.(local\.php|json|log|sql|bak|env)$">
		Require all denied
	</FilesMatch>
	# SEO fix 2026-10-28: also block backup/editor copies (e.g. packages.json.bak-cebu, file.old, file~)
	<FilesMatch "(\.bak-[A-Za-z0-9_-]+|\.old|\.orig|\.swp|\.save|~)$">
		Require all denied
	</FilesMatch>
</IfModule>

# SEO fix 2026-10-28: browser caching for static files (CSS/JS kept short because some are not versioned)
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType image/gif "access plus 30 days"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType image/x-icon "access plus 30 days"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType font/woff "access plus 1 year"
	ExpiresByType font/ttf "access plus 1 year"
	ExpiresByType application/font-woff2 "access plus 1 year"
	ExpiresByType text/css "access plus 7 days"
	ExpiresByType application/javascript "access plus 7 days"
	ExpiresByType text/javascript "access plus 7 days"
</IfModule>

# The form script adds the anti-spam token. Always revalidate it so visitors never keep an old copy
# (an old copy has no token, and the enquiry would be rejected).
<IfModule mod_headers.c>
	<FilesMatch "^(kuyaely-nav\.js|ke-form-token\.php)$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>

# SEO fix 2026-10-28: compression
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>

<IfModule mod_php.c>
	php_flag display_errors Off
	php_flag expose_php Off
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "^(index-2|index-2dark|index-3|index-3classic|index-3classic-dark|index-3dark|index-classic|index-classic-light|index-light|login|blog|blog-2colum|blog-details|blog-list|donation|donation-details|destination|tour-details|tour-grid|tour-list)\.html$">
		Header set X-Robots-Tag "noindex, nofollow"
	</FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
	Options -MultiViews
	RewriteEngine On
	RewriteBase /

	# NOTE 2026-10-28: the HTTP->HTTPS redirect below already checks X-Forwarded-Proto so it does not loop
	# behind Cloudflare. Do not add a second HTTPS redirect here. If http:// still errors, turn on
	# "Always Use HTTPS" and SSL mode "Full (strict)" in the Cloudflare dashboard instead.

	# SEO fix 2026-10-28: old theme demo pages are gone for good (410). Files kept on disk.
	RewriteRule ^(index-2|index-2dark|index-3|index-3dark|index-3classic|index-3classic-dark|index-classic|index-classic-light|index-light|donation|donation-details|team|team-details|blog|blog-2colum|blog-list|blog-details|login|tour-grid|tour-list|tour-details|destination|service-details)(\.html)?/?$ - [G,L,NC]

	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !=https
	RewriteRule ^ https://kuyaelytours.com%{REQUEST_URI} [R=301,L]

	RewriteCond %{HTTP_HOST} ^www\.kuyaelytours\.com$ [NC]
	RewriteRule ^ https://kuyaelytours.com%{REQUEST_URI} [R=301,L]

	# /index.html -> /
	RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
	RewriteRule ^index\.html$ / [R=301,L]

	# /about.html -> /about
	RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
	RewriteRule ^ %1 [R=301,L,NE]

	# /tours/package-slug -> tour.php
	RewriteRule ^tours/([a-z0-9-]+)/?$ /tour.php?p=$1 [L,QSA]

	RewriteRule ^sitemap\.xml$ /sitemap.php [L]

	# Partner with us
	RewriteRule ^return-policy/?$ /return-policy.php [L,QSA]
	RewriteRule ^partners/?$ /partners.php [L,QSA]
	RewriteRule ^partner/?$ /partner/index.php [L,QSA]
	RewriteRule ^partner/login/?$ /partner/login.php [L,QSA]
	RewriteRule ^partner/apply/?$ /partner/apply.php [L,QSA]

	# Island catalog pages use CMS packages, not the old static HTML
	RewriteRule ^(cebu|bohol|siquijor|dumaguete)-tour/?$ /island-tour.php?island=$1 [L,QSA]

	# /about -> about.html
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME}.html -f
	RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
